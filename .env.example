# Supabase (audit store; schema betting_experiments is created automatically)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
BETX_DB_SCHEMA=profit_trading_exp

# ProphetArena production DB (prediction source, read-only)
ARENA_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
BETX_LANES=gemini:agent-gemini-3.1-pro:fundamental:150:brier,fable-5:agent-claude-fable-5:fundamental:150:brier,gemini-log:agent-gemini-3.1-pro:fundamental:150:log
BETX_ARENA_REFERENCE_PREDICTORS=gemini-3.1-pro,claude-fable-5

# Kalshi (RSA-PSS; private key = base64 of the PEM)
KALSHI_BASE_URL=https://api.elections.kalshi.com
KALSHI_API_KEY_ID=...
KALSHI_PRIVATE_KEY_B64=...

# Execution
BETX_INSTANCE=betx-live-1
BETX_DRY_RUN=true
BETX_LIVE_ENABLED=true
BETX_POLL_INTERVAL_SEC=600
BETX_CLOSE_BUFFER_HOURS=24

# Optional: own-schedule predictor mode
BETX_MODEL_SPEC=gemini:gemini-3.1-pro-preview
PREDICTOR_SERVICE_URL=
PREDICTOR_API_KEY=
GEMINI_API_KEY=

# --- collection (read-only, both venues, one worker: engine/collect.py) ---
# Separate from BETX_POLL_INTERVAL_SEC, which paces the TRADING loop.
BETX_COLLECT_INTERVAL_SEC=3600   # hourly
BETX_PM_ENABLED=true
BETX_KX_ENABLED=true
BETX_PM_UNIVERSE=arena            # arena | all | both
# Kalshi scope (arena tracks ~15k open markets; 0 disables a window).
# Forecast recency only - close time is NOT a filter, or you lose books for
# markets the engine still trades.
BETX_KX_FORECAST_WITHIN_DAYS=30
BETX_KX_CLOSING_WITHIN_DAYS=0
# BETX_PM_HISTORY_FIDELITY=60     # hourly; 1 = per-minute, 60x the rows
# BETX_PM_COLLECT_HISTORY=false
# BETX_PM_HISTORY_EVERY_N=12      # API-call cadence, NOT row volume
# BETX_PM_EXTRA_SLUGS=some-event-slug,another-event-slug
# BETX_PM_PREDICTORS=              # empty = every arena predictor

# --- streaming collection (engine/stream.py, separate worker) ---
BETX_STREAM_ENABLED=false         # ~89 GB/month if on; see README
BETX_STREAM_MIN_INTERVAL_SEC=30   # max one book row per market per N sec
# BETX_STREAM_KX_MAX_TICKERS=5000
# BETX_STREAM_PM_ENABLED=true
# BETX_STREAM_KX_ENABLED=true
