# Supabase (audit store; schema betting_experiments is created automatically)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
BETX_DB_SCHEMA=betting_experiments

# ProphetArena production DB (prediction source, read-only)
ARENA_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
BETX_ARENA_PREDICTOR=agent-gemini-3.1-pro
BETX_ARENA_REFERENCE_PREDICTORS=gemini-3.1-pro

# Kalshi (RSA-PSS; private key = base64 of the PEM)
KALSHI_BASE_URL=https://api.elections.kalshi.com
KALSHI_API_KEY_ID=...
KALSHI_PRIVATE_KEY_B64=...

# Execution
BETX_INSTANCE=betx-haifeng
BETX_DRY_RUN=true
BETX_LIVE_ENABLED=true
BETX_POLL_INTERVAL_SEC=600
BETX_CLOSE_BUFFER_HOURS=24
BETX_BANKROLL_MOMENTUM=150
BETX_BANKROLL_FUNDAMENTAL=150

# Optional: own-schedule predictor mode
BETX_MODEL_SPEC=gemini:gemini-3.1-pro-preview
PREDICTOR_SERVICE_URL=
PREDICTOR_API_KEY=
GEMINI_API_KEY=
